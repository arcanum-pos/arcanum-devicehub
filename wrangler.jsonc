{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arcanum-devicehub",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-13",
	"dev": {
		"port": 8790,
		"inspector_port": 9790
	},
	// No custom domain and no workers.dev route: every path here, including
	// the notification WebSocket (/devices/connect), is reached only through
	// arcanum-bff's ARCANUM_DEVICEHUB_SERVICE binding now — see that repo's
	// index.ts. Explicit false (not just omitted), same reasoning as
	// arcanum-backend's own workers_dev: false — it defaults to true when
	// unset, so a future deploy can't silently re-expose this Worker.
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arcanum-devices",
			"database_id": "610c5482-d2f2-472d-842d-4dcfd97e8ded"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_HUB",
				"class_name": "DeviceHub"
			}
		]
	},
	"migrations": [
		// new_sqlite_classes (not new_classes): Durable Objects on the Workers
		// Free plan require the SQLite storage backend.
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceHub"
			]
		},
		// Purely cosmetic cleanup: the DO namespace created at v1 is still
		// internally labeled with the script's pre-rename name
		// (questo-devicehub) -- Cloudflare's dashboard never updates that
		// label on a later Worker rename. Retiring and recreating the class
		// here (safe: DeviceHub never calls state.storage at all, only the
		// WebSocket Hibernation API for live connections) gets a fresh
		// namespace labeled under the current name, arcanum-devicehub. Done
		// while there's no live traffic; any currently-open kiosk sockets
		// would drop and auto-reconnect via connectNotifications' own
		// backoff logic.
		{
			"tag": "v2",
			"deleted_classes": [
				"DeviceHub"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"DeviceHub"
			]
		}
	],
	"observability": {
		"enabled": true
	},
	// Explicit empty array, not just an absent key: the "Replace
	// presence-based auto-deletion with manual device removal" commit
	// removed the scheduled() handler and this triggers block back on
	// 2026-09-14, but omitting the `triggers` key from a deploy only means
	// "don't touch whatever's already configured" — it does NOT clear an
	// existing Cron Trigger on Cloudflare's side. That trigger (*/5 * * * *)
	// kept firing against a Worker with no scheduled() export ever since,
	// erroring every 5 minutes with no functional impact (nothing depended
	// on it) but polluting the logs. This explicit empty array is what
	// actually tells Cloudflare to remove it.
	"triggers": {
		"crons": []
	}
}
