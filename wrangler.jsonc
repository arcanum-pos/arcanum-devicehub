{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arcanum-devicehub",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-13",
	"dev": {
		"port": 8790,
		"inspector_port": 9790
	},
	// Explicit now that a custom domain is the canonical public entry point
	// (adding `routes` silently disables workers_dev by default otherwise —
	// pinned here so a future deploy can't silently re-enable it, same
	// reasoning as arcanum-backend's own workers_dev: false).
	"workers_dev": false,
	"routes": [
		{
			"pattern": "arcanum-devicehub.kaboutersoft.be",
			"custom_domain": true
		}
	],
	"vars": {
		// Base URL this Worker is reachable at — used to build the ws:// URL
		// handed back to clients. Verify this matches the actual deployed URL
		// after any future rename (Workers & Pages → arcanum-devicehub → the
		// custom domain or workers.dev URL shown there) and update + redeploy
		// if it doesn't — a stale value here fails silently: the client just
		// can't open its notification socket, so it never appears "online"
		// anywhere (e.g. kassa Settings' device-link list, which only shows
		// devices with a live socket — see listUnlinked).
		"WORKER_PUBLIC_URL": "https://arcanum-devicehub.kaboutersoft.be"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "questo-devices",
			"database_id": "87f7046e-1e85-4724-a09a-a3f81a22ab40"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_HUB",
				"class_name": "DeviceHub"
			}
		]
	},
	"migrations": [
		// new_sqlite_classes (not new_classes): Durable Objects on the Workers
		// Free plan require the SQLite storage backend.
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceHub"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}
