{
  "name": "arcanum-devicehub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc && tsc -p tsconfig.node.json && tsc -p test && tsc -p test/node",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:node": "esbuild src/node-main.ts --bundle --platform=node --format=esm --target=node22 --loader:.sql=text --outfile=dist/node.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:node": "node dist/node.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.12",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "$wrangler",
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "ws": "^8.22.0"
  }
}
